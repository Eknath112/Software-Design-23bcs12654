        <mxCell id="bxrBn9oV0BfrnRSA3-FH-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b&gt;Functional Requirements&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;User authentication (register/login/logout)&lt;/li&gt;&lt;li&gt;Upload image + optional description&lt;/li&gt;&lt;li&gt;Generate:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;AI captions (multiple tones)&lt;/li&gt;&lt;li&gt;Hashtags (high/medium/low reach)&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Perform image analysis:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Objects, colors, mood&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Provide content improvement suggestions&lt;/li&gt;&lt;li&gt;Show engagement tips (best time, etc.)&lt;/li&gt;&lt;li&gt;Dashboard to view and manage posts&lt;/li&gt;&lt;li&gt;Delete/update posts&lt;/li&gt;&lt;li&gt;Track basic engagement metrics&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="420" x="65" y="210" as="geometry" />
        </mxCell>
        <mxCell id="bxrBn9oV0BfrnRSA3-FH-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b&gt;Non functional requirements&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Scalability: Handle many uploads + AI requests&lt;/li&gt;&lt;li&gt;Performance: AI response &amp;lt; 3–5 seconds (async preferred)&lt;/li&gt;&lt;li&gt;Availability: 99.9% uptime&lt;/li&gt;&lt;li&gt;Security:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;JWT auth&lt;/li&gt;&lt;li&gt;Hashed passwords&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Reliability:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Retry AI failures&lt;/li&gt;&lt;li&gt;Fallback AI providers&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Storage efficiency: Optimize image storage&lt;/li&gt;&lt;li&gt;Extensibility: Plug different AI providers easily&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="510" x="430" y="200" as="geometry" />
