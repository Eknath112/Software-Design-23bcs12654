# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/insta-optimizer

# JWT Secret (change this to a random string in production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# AI API Configuration (Choose one)
# Google Gemini API Key (FREE - Recommended for students)
GEMINI_API_KEY=your_gemini_api_key_here

# OR OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# OR Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Choose which AI service to use: 'gemini', 'openai', or 'anthropic'
AI_SERVICE=gemini

# File Upload Configuration
MAX_FILE_SIZE=10485760
# 10MB in bytes
